@@ -0,0 +1,54 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <string_view>
+
+namespace sphaira::category {
+
+// Preserve existing store filter IDs so saved game/emulator filters keep their meaning.
+enum Type : long {
+    All = 0, Games = 1, Emulators = 2, SystemTools = 3,
+    Other = 7, GameTools = 8, MediaNetwork = 9,
+};
+
+inline constexpr std::array Filters{All, Games, GameTools, Emulators, SystemTools, MediaNetwork, Other};
+
+constexpr auto NormalizeFilter(long value) -> Type {
+    if (value == 4 || value == 5) return SystemTools;
+    if (value == 6) return Other;
+    for (const auto type : Filters) {
+        if (value == type) return type;
+    }
+    return All;
+}
+
+constexpr auto FilterIndex(long value) -> std::size_t {
+    const auto type = NormalizeFilter(value);
+    for (std::size_t i = 0; i < Filters.size(); i++) {
+        if (Filters[i] == type) return i;
+    }
+    return 0;
+}
+
+constexpr auto Matches(long filter, Type type) -> bool {
+    return NormalizeFilter(filter) == All || NormalizeFilter(filter) == type;
+}
+
+constexpr auto Label(Type type) -> const char* {
+    switch (type) {
+        case All: return "All";
+        case Games: return "Games";
+        case GameTools: return "Game Tools";
+        case Emulators: return "Emulators";
+        case SystemTools: return "System Tools";
+        case MediaNetwork: return "Media & Network";
+        case Other: return "Other";
+    }
+    return "Other";
+}
+
+auto ForPackage(std::string_view id, std::string_view original_category) -> Type;
+auto ForPath(std::string_view path) -> Type;
+
+} // namespace sphaira::category
--- /dev/null
+++ b/sphaira/source/app_category.cpp
@@ -0,0 +1,33 @@
+#include "app_category.hpp"
+#include <unordered_map>
+
+namespace sphaira::category {
+namespace {
+
+const std::unordered_map<std::string_view, Type> categories{
+#include "app_categories.inc"
+};
+
+} // namespace
+
+auto ForPackage(std::string_view id, std::string_view original_category) -> Type {
+    if (const auto it = categories.find(id); it != categories.end()) {
+        return it->second;
+    }
+    if (original_category == "game") return Games;
+    if (original_category == "emu") return Emulators;
+    if (original_category == "tool" || original_category == "advanced" || original_category == "theme") {
+        return SystemTools;
+    }
+    return Other;
+}
+
+auto ForPath(std::string_view path) -> Type {
+    if (path.starts_with("sdmc:")) path.remove_prefix(5);
+    if (const auto it = categories.find(path); it != categories.end()) {
+        return it->second;
+    }
+    return Other;
+}
+
+} // namespace sphaira::category
